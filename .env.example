# Окружение стека KTTF. Скопировать в .env и заменить пароли.
# .env под гитигнором — бриф, запрет №9: секретов в репозитории нет.

# --- PostgreSQL ---
POSTGRES_USER=kttf
# Тот же пароль зашит в DATABASE_URL файла kttf-back/.env.example.
# Меняете здесь — меняйте и там, иначе бэкенд не подключится к базе.
POSTGRES_PASSWORD=kttf_local_dev
POSTGRES_DB=kttf
# Смещён с 5432: на машине разработчика уже может стоять свой PostgreSQL
POSTGRES_PORT=5433

# --- Redis ---
# Смещён с 6379 по той же причине
REDIS_PORT=6380

# --- MinIO ---
MINIO_ROOT_USER=kttf
MINIO_ROOT_PASSWORD=change_me_local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Приложения ---
# development, а не production: при production API намеренно не поднимется,
# пока нет провайдера SMS — код входа уходит в лог, и это дыра (ОВ-9).
NODE_ENV=development
IMAGE_TAG=local
KTTF_DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443

# Ключи подписи API. Здесь заглушки для локального стека, в .env заменить
# своими: файл под гитигнором — бриф, запрет №9. Минимум 32 символа, иначе
# приложение откажется стартовать.
# Сгенерировать: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=local_dev_only_change_me_0123456789abcdef
AUTH_CODE_SECRET=local_dev_only_change_me_fedcba9876543210

# --- Наблюдаемость (профиль observability) ---
GRAFANA_PASSWORD=change_me_local
GRAFANA_PORT=3001
