# Окружение стека KTTF. Скопировать в .env и заменить пароли.
# .env под гитигнором — бриф, запрет №9: секретов в репозитории нет.

# --- PostgreSQL ---
POSTGRES_USER=kttf
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=kttf
# Смещён с 5432: на машине разработчика уже может стоять свой PostgreSQL
POSTGRES_PORT=5433

# --- Redis ---
# Смещён с 6379 по той же причине
REDIS_PORT=6380

# --- MinIO ---
MINIO_ROOT_USER=kttf
MINIO_ROOT_PASSWORD=change_me_local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Приложения (профиль apps) ---
NODE_ENV=development
IMAGE_TAG=local
KTTF_DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443

# --- Наблюдаемость (профиль observability) ---
GRAFANA_PASSWORD=change_me_local
GRAFANA_PORT=3001
