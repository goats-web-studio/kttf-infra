# Окружение стека KTTF в проде. bootstrap.sh копирует этот файл в
# /opt/kttf/kttf-infra/.env и подставляет свежие секреты вместо __GENERATE__.
# Файл .env только на сервере, права 600 — бриф, запрет №9.

COMPOSE_PROFILES=observability

# --- PostgreSQL ---
POSTGRES_USER=kttf
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=kttf
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PORT=6380

# --- MinIO ---
MINIO_ROOT_USER=kttf
MINIO_ROOT_PASSWORD=__GENERATE__
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Приложения ---
KTTF_DEMO_SEED=0
NODE_ENV=production
KTTF_DOMAIN=kttf.kz
HTTP_PORT=80
HTTPS_PORT=443
KTTF_HSTS=max-age=31536000
JWT_SECRET=__GENERATE__

# Теги образов в GHCR. Меняет deploy.sh при каждой выкладке.
API_TAG=main
WEB_TAG=main

# Если пакеты в GHCR приватные — пользователь GitHub и токен read:packages.
# Пусто — пакеты публичные, вход не нужен.
GHCR_USER=
GHCR_TOKEN=

# --- Наблюдаемость ---
GRAFANA_PASSWORD=__GENERATE__
GRAFANA_PORT=3001

# --- Резервные копии (backup.sh) ---
BACKUP_DIR=/opt/kttf/backups
BACKUP_KEEP_DAYS=14
# Куда дополнительно копировать архивы вне сервера (rsync), например
# backup@storage.example.kz:/kttf. Пусто — только локально.
BACKUP_RSYNC_TARGET=
