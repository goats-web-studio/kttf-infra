# Обратный прокси KTTF.
#
# Единственная точка входа: всё, что приходит снаружи, проходит здесь.
# Приложения своих портов наружу не открывают.

{$KTTF_DOMAIN:localhost} {
	# API под префиксом /api — фронт и бэк живут на одном домене,
	# поэтому CORS не нужен вовсе, а куки работают без ухищрений.
	handle /api/* {
		reverse_proxy kttf-api:3000
	}

	# Вебсокеты второго экрана и живого обновления консоли (ТС 7.7)
	handle /ws/* {
		reverse_proxy kttf-api:3000
	}

	# Всё остальное — статика фронта
	handle {
		reverse_proxy kttf-web:80
	}

	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# Политика CSP (ADR-055). Включена 19.10.2026 после прохода всех экранов
		# в режиме отчёта: публичная часть, кабинет, консоль с сетью и без, экран
		# зала с SSE. Единственный отказ — проба Zod «можно ли исполнять строки»:
		# получив отказ, Zod разбирает без этого ускорения.
		#   style-src 'unsafe-inline' — MUI (emotion) вставляет стили тегом
		#   img-src https: — логотипы клубов из прошлого внешними ссылками
		#   font-src data: — Vite встраивает мелкие шрифты в CSS строкой
		#   frame-src — видео YouTube по нажатию, без cookie (docs/09, MVP-2)
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	log {
		output stdout
		format json
	}
}
